rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Products collection: public read, write for store management
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    // Categories collection: public read, write for store management
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }

    // Orders collection: public create and read for tracking
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Connection testing
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
